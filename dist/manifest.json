{
  "manifest_version": 3,
  "name": "LeetCode 艾宾浩斯复习助手",
  "short_name": "LC Ebbinghaus",
  "description": "基于艾宾浩斯遗忘曲线与 SM-2 算法的力扣刷题及间隔复习提醒助手",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "LeetCode 艾宾浩斯复习助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://leetcode.cn/problems/*",
        "*://leetcode.com/problems/*"
      ],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://leetcode.cn/*",
    "*://leetcode.com/*"
  ]
}
